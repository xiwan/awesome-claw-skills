# Copy to <clawd_root>/secrets/comfyui.env and fill in your own values.
# Do NOT commit the filled-in file.

# Required — base URL of your ComfyUI server.
COMFY_HOST=http://localhost:8188

# Optional — only if your endpoint sits behind an auth layer.
# The value is sent as a request header on every call.
#COMFY_API_KEY=
#COMFY_AUTH_HEADER=X-Comfy-Key

# Optional — backend runs on EC2. Enables `--wake` and scripts/instance.sh.
#COMFY_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
#COMFY_AWS_REGION=us-east-1

# Optional — where images land. Default: ~/clawd/output/images
#COMFY_OUT=~/clawd/output/images
