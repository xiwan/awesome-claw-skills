# Copy this to one of the locations the scripts auto-discover, and fill in
# your own values. Do NOT commit the filled-in file.
#
# Discovery order (first match wins):
#   1. $YUE2_ENV_FILE  (explicit path override)
#   2. secrets/yue2.env  — searched walking up from the scripts/ dir
#   3. ~/clawd/secrets/yue2.env  /  ~/.config/yue2/yue2.env  /  ~/.yue2.env
#
# Only needed if the YuE2 runtime lives on a remote GPU host driven by
# scripts/remote.sh. If you run YuE2 on the same machine as the agent, ignore
# this file and call scripts/run_yue2.py directly.

# --- Which host to drive -----------------------------------------------------
# Prefer the Name tag: it survives rebuilding the instance.
YUE2_INSTANCE_TAG=yue2-gpu
# An explicit id overrides the tag lookup.
#YUE2_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
YUE2_AWS_REGION=us-east-1

# --- Handing artifacts back --------------------------------------------------
# Audio is far too large for SSM command output, so files move through S3.
# The instance role needs s3:PutObject on this bucket; your local credentials
# need s3:GetObject. Keep the bucket private and set a lifecycle expiry.
YUE2_BUCKET=your-yue2-transfer-bucket

# --- Layout on the host ------------------------------------------------------
#YUE2_REMOTE_DIR=/opt/yue2
#YUE2_REMOTE_USER=ubuntu

# --- Where finished songs land locally --------------------------------------
#YUE2_OUT=~/clawd/output/music

# --- Credential hygiene ------------------------------------------------------
# Set to 1 if stale AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# in your environment shadow the working credentials in ~/.aws/credentials.
# Symptom: every call fails with AuthFailure or InvalidClientTokenId.
#YUE2_CLEAR_ENV_CREDS=1
